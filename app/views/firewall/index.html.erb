<h2>Firewall Rules (iptables -L)</h2>
<%= @allowed_ips_output%>

<%= form_with(model: @firewall, local: true) do |form|  %>
    <div>
      <%= f.label :name, "Name Rule" %>
      <%= f.text_field :name %>
    </div>
  
    <div>
      <%= f.label :ipAddress, "IP Allow" %>
      <%= f.text_field :ipAddress %>
    </div>
  
    <div>
      <%= f.submit "Submit" %>
    </div>
  <% end %>