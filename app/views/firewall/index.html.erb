<h2>Firewall Rules (iptables -L)</h2>
<%= @allowed_ips_output%>

<%= form_for :firewall, url: firewall_create_path do |f| %>
    <div>
      <%= f.label :name, "Name Rule" %>
      <%= f.text_field :name %>
    </div>
  
    <div>
      <%= f.label :ipAddress, "IP Allow" %>
      <%= f.text_field :ipAddress %>
    </div>
  
    <div>
      <%= f.submit "Submit" %>
    </div>
  <% end %>