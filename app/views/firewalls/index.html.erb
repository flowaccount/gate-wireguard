<h2>Rules Access</h2>

<%= turbo_frame_tag "status_display" do %>
  <p>Select Name List:</p>

  <%= form_with(url: update_display_rules_path(:name), method: :patch, local: true) do %>
    <%= select_tag :name, options_for_select(["please select","allowed_remotes", "allowed_remotes_crm"], selected: 'Active'),{ onchange: "this.form.submit();" } %>
  <% end %>

  <span>Allowed IPs:
  <%= @allowed_ips_output%>
  </span>
<% end %>

<br/><br/>

<%= form_for @firewall do |f|  %>
    <div>
      <%= f.label :name, "Name Rule" %>
      <%= f.text_field :name %>
    </div>
  
    <div>
      <%= f.label :ipAddress, "IP Allow" %>
      <%= f.text_field :ipAddress %>
    </div>
  
    <div>
      <%= f.submit "Submit" %>
    </div>
  <% end %>