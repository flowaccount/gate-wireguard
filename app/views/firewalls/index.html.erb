<h2>Rules Access</h2>

<%= turbo_frame_tag "status_display" do %>
  <p>Select Name List:</p>
  <%= form_with model: @firewall,url: update_display_rules_path, method: :patch, data: { turbo_frame: "status_display" } do |f| %>
    <%= f.select :name, ["please select","allowed_remotes", "allowed_remotes_crm"], {}, { onchange: "this.form.submit();" } %>
  <% end %>

  <p>Allowed IPs:</p>
  <%= @allowed_ips_output%>
<% end %>


<%= form_for @firewall do |f|  %>
    <div>
      <%= f.label :name, "Name Rule" %>
      <%= f.text_field :name %>
    </div>
  
    <div>
      <%= f.label :ipAddress, "IP Allow" %>
      <%= f.text_field :ipAddress %>
    </div>
  
    <div>
      <%= f.submit "Submit" %>
    </div>
  <% end %>