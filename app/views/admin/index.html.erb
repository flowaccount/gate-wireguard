
<% if @current_user.vpn_devices.empty? %>
  <div class="container my-5">
    <div class="bg-body-tertiary p-5 rounded">
      <div class="col-sm-8 py-5 mx-auto">
        <h3 class="fw-normal">You don't have any devices</h3>
        <p>Let's get started.</p>
        <p>
          <%# data-turbo-prefetch=false stops Turbo Drive from prefetching this
              link on hover. Without it, the prefetch issues a GET to
              /vpn_devices/new — which currently persists a VpnDevice as a side
              effect — and creates accidental duplicates every time the user's
              mouse passes over the button. data: { turbo_method: :get } keeps
              the click behavior identical. %>
          <%= link_to "Let's add a device",
                      new_vpn_device_path,
                      class: "btn btn-primary",
                      role: "button",
                      data: { turbo_prefetch: false } %>
        </p>
      </div>
    </div>
  </div>
<% else %>

  <div class="border-primary rounded-3">
    <h2>WireGuard Configuration</h2>
    <h6>WireGuard is a modern VPN protocol with state-of-the-art formally verified cryptography while being extremely
      minimal and fast. It is a VPN protocol that is very easy to setup and use. It is also very secure and fast. You can
      read more about WireGuard <a href="https://www.wireguard.com/">here</a></h6>

  </div>
  <hr>

  <h4>Hello! <%= @current_user.name %>, Your VPN Devices</h4>
<%= render 'vpn_devices/vpn_devices', vpn_devices: @current_user.vpn_devices %>
<% end %>

